# Copy to ~/Library/AgentMail/config.env (Mac) or ~/.local/share/agentmail/config.env (Linux).
# Never commit a filled copy. Same keys as the app's Supabase/Resend.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
GROK_BIN=
POLL_SECONDS=30
GROK_TIMEOUT=2700
MAX_TURNS=40

# Folder the worker opens for a.* / e.* mailboxes (Settings → Agents).
# Default: ~/Documents. a.foo looks for ~/Documents/foo then ~/Documents/a.foo.
# Optional override file: workspaces.json (see workspaces.json.example).
WORKSPACE_ROOT=
