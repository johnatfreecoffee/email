# ============================================================================
#  Email App — ENV TEMPLATE  (safe to commit; copy to .env.local and fill in)
#  Forked from Mission Control. See EMAIL-SYSTEM.md §9 for the full var table.
# ============================================================================

# ---- Frontend build (Next.js). NEXT_PUBLIC_* are inlined into the client. ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Supabase anon/public JWT (safe in client)
NEXT_PUBLIC_MC_API_SECRET=               # shared auth gate; must == MC_API_SECRET
NEXT_PUBLIC_VAPID_PUBLIC_KEY=            # web-push public key; must match VAPID_PUBLIC_KEY

# ---- Pages Functions runtime (server-side; NEVER exposed to the browser) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=                        # same anon JWT as above
SUPABASE_SERVICE_KEY=                     # Supabase service_role JWT (server writes)
RESEND_API_KEY=                           # Resend API key (inbound webhook + outbound send)
CLOUDFLARE_API_TOKEN=                     # CF token: Pages + DNS + Zones (domain auto-config)
CLOUDFLARE_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
OPENROUTER_KEY=                           # OpenRouter (optional: AI features / spam assist)
VAPID_PUBLIC_KEY=                         # web-push keypair — public half
VAPID_PRIVATE_KEY=                        # web-push keypair — private half
MC_API_SECRET=                            # shared auth gate; must == NEXT_PUBLIC_MC_API_SECRET

# Generate a fresh VAPID keypair with:  npx web-push generate-vapid-keys --json
